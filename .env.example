# Paiement Stripe (boutique + acompte en ligne des devis)
STRIPE_SECRET_KEY=sk_test_xxx
# Mot de passe du back-office (boutique et outil Devis & BAT)
ADMIN_PASSWORD=changez-moi
PORT=4242
# URL publique utilisée dans les liens envoyés aux clients (ex. https://atelier.mondomaine.fr)
PUBLIC_URL=

# Optionnel : envoi des emails directement depuis l'outil Devis & BAT
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mon atelier <devis@mondomaine.fr>"
