# Paiement Stripe (boutique + acompte en ligne des devis)
STRIPE_SECRET_KEY=sk_test_xxx
# Mot de passe du back-office (boutique et outil Devis & CRM)
ADMIN_PASSWORD=changez-moi
PORT=4242
# URL publique utilisée dans les liens envoyés aux clients (ex. https://atelier.mondomaine.fr)
PUBLIC_URL=
# Derrière un hébergeur ou un proxy (Render, OVH, Nginx…) : 1
TRUST_PROXY=

# --- Boîte mail (facultatif : se règle aussi dans Paramètres > Boîte mail) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mon atelier <devis@mondomaine.fr>"
IMAP_HOST=
IMAP_PORT=993

# --- Pennylane (facultatif : se règle aussi dans Paramètres > Pennylane) ---
PENNYLANE_API_KEY=
